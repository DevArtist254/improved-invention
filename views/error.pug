doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet")
    link(rel="stylesheet", href="/style/style.css")
    title #{title}: #{status}

  body
    .error-box
      h1 Oops! An error occurred.
      p Status Code: #{status}
      p #{message}
      a(href="/") Go back home
